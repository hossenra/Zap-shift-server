# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Server port (Render sets this automatically)
PORT=4000

# MongoDB Atlas credentials
DB_USER=your_mongodb_user
DB_PASS=your_mongodb_password
# Optional: full connection string; overrides DB_USER / DB_PASS when set
# MONGODB_URI=mongodb+srv://user:pass@cluster0.example.mongodb.net/parcelDB

# Stripe secret key (starts with sk_test_ or sk_live_)
PAYMENT_GATEWAY_KEY=sk_test_xxx

# Allowed frontend origins, comma-separated (leave empty to allow all)
CLIENT_URL=http://localhost:5173

# Firebase Admin service account, base64-encoded.
# Generate with:  base64 -i firebase-admin-key.json | tr -d '\n'
# Locally you can skip this and put firebase-admin-key.json in the project root instead.
# FIREBASE_SERVICE_KEY=
